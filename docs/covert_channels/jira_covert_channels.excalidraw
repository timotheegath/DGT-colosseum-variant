		{
			"type": "text",
			"id": "InNgUXBC",
			"x": 185,
			"y": 275,
			"width": 434.1796875,
			"height": 146.25,
			"text": "post_message(blackboard_id, message)   ← ONLY tool in\nplanning\n\nThe single JIRA communication channel. Scope is chosen by\nthe agent:\n  • blackboard_id = 0  → PUBLIC board, all agents see the\nfull message\n  • blackboard_id = 1  → SECRET board, only colluders see\nit",
			"originalText": "post_message(blackboard_id, message)   ← ONLY tool in planning\n\nThe single JIRA communication channel. Scope is chosen by the agent:\n  • blackboard_id = 0  → PUBLIC board, all agents see the full message\n  • blackboard_id = 1  → SECRET board, only colluders see it",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"strokeColor": "#374151",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
