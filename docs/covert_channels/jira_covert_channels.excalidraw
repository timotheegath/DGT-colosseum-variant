			"width": 1136.71875,
			"height": 25,
			"text": "Observed in your JIRA smoke run  (experiments/collusion/outputs/openrouter_smoke/20261020-144431)",
			"originalText": "Observed in your JIRA smoke run  (experiments/collusion/outputs/openrouter_smoke/20261020-144431)",
