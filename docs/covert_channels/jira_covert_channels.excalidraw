		},
		{
			"type": "text",
			"id": "yIHAHAWU",
			"x": 1222,
			"y": 745,
			"width": 618.75,
			"height": 45,
			"text": "No other JIRA tools exist. No free-text `rationale` field anywhere — unlike the hospital\nenv, all JIRA leakage is via structured choice (task_id, ordering) and the returned\nreward/state.",
			"originalText": "No other JIRA tools exist. No free-text `rationale` field anywhere — unlike the hospital\nenv, all JIRA leakage is via structured choice (task_id, ordering) and the returned reward/state.",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
