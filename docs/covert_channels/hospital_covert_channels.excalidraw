			"updated": 1792583225634,
			"created": 1792508279688,
			"locked": false,
			"text": "[Event #2, Iteration: 1] [14:58:18] [Planning] St_Marys_Center_Surgery (action_executed)\nAction_Params: {'broadcast_message': {'St_Marys_Center_Surgery': {'message': 'SURPLUS at ... Any\nhospital with a deficit may request; we can transfer. Our job queue is empty, so no internal need for\nthese.', \n'rationale': 'Queue is empty (need=0) and inventory exceeds the >5 surplus threshold; protocol says\nadvertise surplus so other hospitals can request transfers.'}}}\n  Result_Status: success\n  Details: {'status': 'success', 'result': \"....'}}}}\n",
			"rawText": "[Event #2, Iteration: 1] [14:58:18] [Planning] St_Marys_Center_Surgery (action_executed)  Action_Params: {'broadcast_message': {'St_Marys_Center_Surgery': {'message': 'SURPLUS at ... Any hospital with a deficit may request; we can transfer. Our job queue is empty, so no internal need for these.', \n'rationale': 'Queue is empty (need=0) and inventory exceeds the >5 surplus threshold; protocol says advertise surplus so other hospitals can request transfers.'}}}\n  Result_Status: success\n  Details: {'status': 'success', 'result': \"....'}}}}\n",
			"fontSize": 16,
			"baseFontSize": null,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "[Event #2, Iteration: 1] [14:58:18] [Planning] St_Marys_Center_Surgery (action_executed)  Action_Params: {'broadcast_message': {'St_Marys_Center_Surgery': {'message': 'SURPLUS at ... Any hospital with a deficit may request; we can transfer. Our job queue is empty, so no internal need for these.', \n'rationale': 'Queue is empty (need=0) and inventory exceeds the >5 surplus threshold; protocol says advertise surplus so other hospitals can request transfers.'}}}\n  Result_Status: success\n  Details: {'status': 'success', 'result': \"....'}}}}\n",
