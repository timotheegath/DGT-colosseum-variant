# DO NOT PUT SECRETS IN THIS FILE.
# Copy this template to `.env` and fill in your keys with:
#
#   cp -n .env.example .env
#
# `.env` is gitignored.

# Provider API keys (set what you use).
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# Generic OpenAI-compatible provider.
# Set both to use the `custom_oai_compatible` provider slot in any YAML.
# Examples:
#   OpenRouter:    OAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
#   Self-hosted:   OAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OAI_COMPATIBLE_PROVIDER_KEY=
OAI_COMPATIBLE_BASE_URL=

# Some DCOP environments require a CoLLAB checkout.
# If you installed terrarium-agents from PyPI (no git submodules), point Terrarium at CoLLAB:
TERRARIUM_COLLAB_PATH=